---
interface Props { eyebrow?: string; title: string; description?: string; link?: string; linkLabel?: string; }
const { eyebrow, title, description, link, linkLabel = 'See all ↗' } = Astro.props;
---
<div class="section-heading"><div>{eyebrow && <div class="eyebrow">{eyebrow}</div>}<h2>{title}</h2></div>{description && <p>{description}</p>}{link && <a class="text-link" href={link}>{linkLabel}</a>}</div>
<style>.text-link { color: var(--coral); font-weight: 800; text-decoration: none; white-space: nowrap; text-transform: uppercase; letter-spacing: .04em; }.text-link:hover { color: var(--yellow); }</style>
