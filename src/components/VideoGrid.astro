---
import type { Video } from '../data/videos';
import { channelUrl } from '../data/videos';
const { videos } = Astro.props as { videos: Video[] };
---
{videos.length ? <div class="video-grid">{videos.map((video) => <a class="video-card" data-category={video.category} href={video.youtubeUrl} target="_blank" rel="noreferrer"><img src={video.thumbnailUrl} width="640" height="360" loading="lazy" decoding="async" alt={video.title} /><div class="video-info"><span class="eyebrow">{video.category}</span><h3>{video.title}</h3><p>{video.description}</p></div></a>)}</div> : <div class="empty-state"><div class="eyebrow">New videos live on YouTube</div><h3>The next one is worth making room for.</h3><p>Browse the latest Save Room videos and find a place to start.</p><a class="button button--dark" href={`${channelUrl}/videos`} target="_blank" rel="noreferrer">Browse the channel ↗</a></div>}
<style>.video-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 22px; }.video-card { overflow: hidden; color: var(--ink); background: rgba(20,26,58,.9); border: 1px solid var(--line); border-radius: var(--radius-md); text-decoration: none; box-shadow: 0 0 0 1px rgba(255,79,216,.06); transition: transform .2s ease, border-color .2s ease; }.video-card:hover{transform:translateY(-4px);border-color:var(--coral)}.video-card img { width: 100%; aspect-ratio: 16/9; object-fit: cover; background: var(--stone); filter:saturate(1.15) contrast(1.05); }.video-info { padding: 20px; }.video-info h3 { margin: 10px 0; font-size: 1.25rem; }.video-info p { margin-bottom: 0; font-size: .9rem; } @media(max-width:800px){.video-grid{grid-template-columns:1fr 1fr}} @media(max-width:520px){.video-grid{grid-template-columns:1fr}}
</style>
