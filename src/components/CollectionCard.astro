---
import type { Collection } from '../data/collections';
const { collection } = Astro.props as { collection: Collection };
const index = ['classic-rpgs', 'retro-hardware', 'workbench'].indexOf(collection.slug) + 1;
---
<a class={`collection-card ${collection.accent}`} href={`/collections/${collection.slug}`}><span class="collection-number">0{index}</span><span class="eyebrow">{collection.eyebrow}</span><h3>{collection.title}</h3><p>{collection.description}</p><span class="arrow">↗</span></a>
<style>
  .collection-card { position: relative; display: block; min-height: 300px; padding: 28px; overflow: hidden; color: var(--ink); background: rgba(20, 26, 58, .86); border: 1px solid var(--line); border-radius: var(--radius-md); text-decoration: none; transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }.collection-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent,rgba(255,255,255,.08));pointer-events:none}.collection-card:hover { transform: translateY(-5px); border-color: currentColor; box-shadow: var(--shadow); }.collection-card.magenta { color: var(--terracotta); }.collection-card.cyan { color: var(--coral); }.collection-card.yellow { color: var(--yellow); }.collection-card h3 { max-width: 9ch; margin: 30px 0 12px; color: var(--ink); }.collection-card p { max-width: 28ch; color: var(--muted); font-size: .9rem; }.collection-number { position: absolute; top: 24px; right: 26px; font-family: var(--serif); font-size: 2rem; }.arrow { position: absolute; right: 25px; bottom: 20px; font-size: 1.5rem; }
</style>
