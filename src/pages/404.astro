---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This save slot is empty."><section class="not-found container"><div class="eyebrow">404 checkpoint</div><h1>This save slot<br /><em>is empty.</em></h1><p>That page may have moved, but the main menu is still online.</p><a class="button button--dark" href="/">Back to the home page</a></section></BaseLayout>
<style>.not-found{padding:120px 0 180px}.not-found h1{margin:22px 0}.not-found h1 em{color:var(--terracotta);font-style:normal}.not-found p{font-size:1.1rem;margin-bottom:30px}</style>
