---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This room is still being rearranged."><section class="not-found container"><div class="eyebrow">A little rearranging</div><h1>This room<br /><em>is empty.</em></h1><p>That page may have moved, but there is plenty more to explore.</p><a class="button button--dark" href="/">Back to the home page</a></section></BaseLayout>
<style>.not-found{padding:120px 0 180px}.not-found h1{margin:22px 0}.not-found h1 em{color:var(--terracotta)}.not-found p{font-size:1.1rem;margin-bottom:30px}</style>
