---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CollectionCard from '../components/CollectionCard.astro';
import VideoGrid from '../components/VideoGrid.astro';
import SubscribeCta from '../components/SubscribeCta.astro';
import { collections } from '../data/collections';
import { videos, channelUrl } from '../data/videos';
---
<BaseLayout title="Save Room" description="A calmer way to make space for what matters.">
  <section class="hero container">
    <div class="hero-copy"><div class="eyebrow">A little more room for life</div><h1>Make space for what <em>matters.</em></h1><p class="hero-intro">Save Room is a thoughtful corner of the internet for organizing, resetting, and finding the calm inside your everyday spaces.</p><div class="hero-actions"><a class="button button--dark" href={channelUrl} target="_blank" rel="noreferrer">Watch on YouTube ↗</a><a class="button button--outline" href="/collections">Explore collections</a></div></div>
    <div class="hero-art" aria-hidden="true"><div class="art-note">less clutter<br /><em>more living</em></div><div class="art-circle"></div><div class="art-sun"></div><div class="art-stem stem-one"></div><div class="art-stem stem-two"></div></div>
  </section>
  <section class="section container"><SectionHeading eyebrow="From the channel" title="A softer way to get organized." description="Practical inspiration for the rooms you live in, and the life that happens there." link="/watch" linkLabel="Browse videos ↗" /><VideoGrid videos={videos} /></section>
  <section class="section section--tight collection-section"><div class="container"><SectionHeading eyebrow="Find your starting point" title="Make room for the good stuff." /><div class="grid grid--3">{collections.map((collection) => <CollectionCard collection={collection} />)}</div></div></section>
  <section class="quote-section container"><div class="quote-mark">“</div><p>Organization is not about perfection. It’s about making your space support the way you want to live.</p><span>— The Save Room philosophy</span></section>
  <SubscribeCta />
</BaseLayout>
<style>
  .hero { display: grid; grid-template-columns: 1fr .9fr; align-items: center; gap: 60px; min-height: 650px; padding-top: 70px; padding-bottom: 80px; }.hero h1 { margin: 22px 0; }.hero h1 em { color: var(--terracotta); font-style: italic; }.hero-intro { max-width: 43ch; font-size: 1.08rem; }.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }.hero-art { position: relative; min-height: 480px; overflow: hidden; background: var(--olive); border-radius: 48% 48% 22px 22px; }.art-circle { position: absolute; width: 250px; height: 250px; top: 70px; left: 50%; background: var(--coral); border-radius: 50%; transform: translateX(-50%); }.art-sun { position: absolute; width: 100px; height: 100px; top: 145px; left: 23%; background: #e6d495; border-radius: 50%; }.art-note { position: absolute; right: 13%; bottom: 26%; z-index: 1; color: var(--cream); font-family: var(--serif); font-size: 2.2rem; line-height: 1; transform: rotate(-8deg); }.art-note em { color: var(--coral); }.art-stem { position: absolute; bottom: -30px; left: 45%; width: 5px; height: 270px; background: var(--forest); transform-origin: bottom; }.stem-one { transform: rotate(25deg); }.stem-two { left: 54%; height: 225px; transform: rotate(-17deg); }.collection-section { background: var(--paper); }.quote-section { display: grid; grid-template-columns: 110px 1fr; align-items: start; gap: 30px; padding: 110px 0; }.quote-mark { color: var(--terracotta); font-family: var(--serif); font-size: 8rem; line-height: .7; }.quote-section p { max-width: 18ch; margin: 0; color: var(--forest); font-family: var(--serif); font-size: clamp(2.3rem, 5vw, 4.6rem); line-height: 1.05; }.quote-section span { grid-column: 2; color: var(--muted); font-size: .85rem; } @media(max-width:800px){.hero{grid-template-columns:1fr;min-height:0;padding-top:50px}.hero-art{min-height:380px}.quote-section{grid-template-columns:50px 1fr}.quote-section span{grid-column:2}} @media(max-width:520px){.hero-art{min-height:320px}.art-note{font-size:1.7rem}.quote-section{padding:75px 0;gap:15px}.quote-mark{font-size:5rem}}
</style>
