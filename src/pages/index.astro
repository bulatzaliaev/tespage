---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CollectionCard from '../components/CollectionCard.astro';
import VideoGrid from '../components/VideoGrid.astro';
import SubscribeCta from '../components/SubscribeCta.astro';
import { collections } from '../data/collections';
import { videos, channelUrl } from '../data/videos';
---
<BaseLayout title="Save Room" description="Save Room explores retro gaming, classic PC hardware, handhelds, and practical tuning guides for nostalgic players.">
  <section class="hero container">
    <div class="hero-copy"><div class="eyebrow">Retro gaming signal found</div><h1>Load the old worlds <em>again.</em></h1><p class="hero-intro">Save Room is a nostalgic channel for classic games, old PC hardware, handheld shelves, and the tuning notes that keep the rig alive.</p><div class="hero-actions"><a class="button button--dark" href={channelUrl} target="_blank" rel="noreferrer">Watch on YouTube ↗</a><a class="button button--outline" href="/collections">Browse lanes</a></div></div>
    <div class="hero-art" aria-hidden="true"><div class="crt"><div class="crt-screen"><span>PRESS START</span><strong>SAVE ROOM</strong></div><div class="crt-controls"><i></i><i></i><i></i></div></div><div class="sun"></div></div>
  </section>
  <section class="section container"><SectionHeading eyebrow="From the channel" title="Recent saves from the timeline." description="Classic RPGs, strategy legends, handheld corners, and practical PC workbench guides." link="/watch" linkLabel="Browse videos ↗" /><VideoGrid videos={videos} /></section>
  <section class="section section--tight collection-section"><div class="container"><SectionHeading eyebrow="Choose a cartridge" title="Three lanes, one memory card." /><div class="grid grid--3">{collections.map((collection) => <CollectionCard collection={collection} />)}</div></div></section>
  <section class="quote-section container"><div class="quote-mark">▶</div><p>Some games never really leave. They just wait for the next boot screen.</p><span>— Save Room</span></section>
  <SubscribeCta />
</BaseLayout>
<style>
  .hero { display: grid; grid-template-columns: 1fr .9fr; align-items: center; gap: 60px; min-height: 650px; padding-top: 70px; padding-bottom: 80px; }.hero h1 { margin: 22px 0; }.hero h1 em { color: var(--terracotta); font-style: normal; text-shadow: 0 0 22px rgba(255,79,216,.5); }.hero-intro { max-width: 48ch; font-size: 1.08rem; }.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }.hero-art { position: relative; min-height: 480px; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: linear-gradient(180deg, rgba(255,79,216,.13), rgba(39,245,255,.09)), var(--olive); box-shadow: var(--shadow); }.hero-art::after{content:'';position:absolute;inset:auto 0 0;height:48%;background:repeating-linear-gradient(to top,rgba(39,245,255,.25) 0 2px,transparent 2px 28px);transform:perspective(360px) rotateX(58deg);transform-origin:bottom}.sun{position:absolute;width:210px;height:210px;right:10%;top:42px;border-radius:50%;background:repeating-linear-gradient(to bottom,var(--yellow) 0 18px,transparent 18px 28px),linear-gradient(var(--terracotta),var(--yellow));box-shadow:0 0 45px rgba(255,230,109,.25)}.crt{position:absolute;left:10%;right:18%;bottom:18%;z-index:2;padding:18px;background:#060814;border:1px solid var(--line);border-radius:8px;box-shadow:0 28px 80px rgba(0,0,0,.45)}.crt-screen{display:grid;place-items:center;min-height:210px;padding:22px;text-align:center;background:radial-gradient(circle,rgba(39,245,255,.16),rgba(3,7,18,.95));border:1px solid rgba(39,245,255,.28);color:var(--coral)}.crt-screen span{font-size:.72rem;font-weight:800;letter-spacing:.22em}.crt-screen strong{display:block;margin-top:12px;color:var(--ink);font-family:var(--serif);font-size:clamp(2rem,5vw,4rem);line-height:.9;text-shadow:0 0 20px rgba(39,245,255,.7)}.crt-controls{display:flex;gap:10px;margin-top:16px}.crt-controls i{width:12px;height:12px;border-radius:50%;background:var(--terracotta)}.crt-controls i:nth-child(2){background:var(--yellow)}.crt-controls i:nth-child(3){background:var(--coral)}.collection-section { background: rgba(20,26,58,.5); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }.quote-section { display: grid; grid-template-columns: 110px 1fr; align-items: start; gap: 30px; padding: 110px 0; }.quote-mark { color: var(--terracotta); font-family: var(--serif); font-size: 5rem; line-height: .9; }.quote-section p { max-width: 21ch; margin: 0; color: var(--ink); font-family: var(--serif); font-size: clamp(2.1rem, 5vw, 4.4rem); line-height: 1.05; }.quote-section span { grid-column: 2; color: var(--coral); font-size: .85rem; font-weight:800; text-transform:uppercase; } @media(max-width:800px){.hero{grid-template-columns:1fr;min-height:0;padding-top:50px}.hero-art{min-height:380px}.quote-section{grid-template-columns:50px 1fr}.quote-section span{grid-column:2}} @media(max-width:520px){.hero-art{min-height:320px}.crt{left:8%;right:8%;bottom:16%}.crt-screen{min-height:160px}.quote-section{padding:75px 0;gap:15px}.quote-mark{font-size:3rem}}
</style>
