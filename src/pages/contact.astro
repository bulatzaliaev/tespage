---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Work with Save Room on thoughtful home and lifestyle content.">
  <section class="contact-hero container"><div class="eyebrow">Let’s make room</div><h1>Have a good<br /><em>idea?</em></h1><p>Save Room is open to thoughtful collaborations that make everyday spaces feel more useful, more welcoming, or simply more like home.</p><a class="button button--dark" href="https://www.youtube.com/@saveroomorg" target="_blank" rel="noreferrer">Start with the channel ↗</a></section>
  <section class="contact-card container"><div><div class="eyebrow">For partnerships</div><h2>Keep it useful.<br />Keep it human.</h2></div><div><p>For collaboration and business inquiries, please use the contact details listed on the official Save Room YouTube channel.</p><a class="text-link" href="https://www.youtube.com/@saveroomorg/about" target="_blank" rel="noreferrer">Visit the channel About page ↗</a></div></section>
</BaseLayout>
<style>.contact-hero{padding-top:100px;padding-bottom:110px}.contact-hero h1{margin:24px 0}.contact-hero h1 em{color:var(--terracotta)}.contact-hero>p{max-width:43ch;font-size:1.15rem;margin-bottom:30px}.contact-card{display:grid;grid-template-columns:1fr 1fr;gap:50px;padding:60px;margin-bottom:100px;background:#e5a486;border-radius:var(--radius-lg)}.contact-card h2{margin:16px 0}.contact-card p{max-width:35ch;color:rgba(38,48,42,.75)}.text-link{color:var(--forest);font-weight:700;text-decoration:none}@media(max-width:680px){.contact-hero{padding-top:70px;padding-bottom:80px}.contact-card{grid-template-columns:1fr;padding:35px;margin-bottom:70px}}
</style>
