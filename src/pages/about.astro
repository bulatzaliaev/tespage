---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeCta from '../components/SubscribeCta.astro';
---
<BaseLayout title="About" description="Learn more about Save Room, a nostalgic channel for retro games and classic PC hardware.">
  <section class="about-hero container"><div class="eyebrow">About Save Room</div><h1>A channel for<br /><em>old worlds.</em></h1><p>Save Room follows the strange comfort of classic games, early PC memories, handheld collections, and the hardware rituals that make a setup feel personal.</p></section>
  <section class="about-body"><div class="container about-grid"><div class="big-number">01</div><div><div class="eyebrow">The idea</div><h2>Nostalgia with<br />the case open.</h2><p>The channel moves between game history and hands-on tinkering: KOTOR choices, Heroes strategy, Morrowind on old laptops, PSP corners, and BIOS tuning when the modern rig needs a steadier heartbeat.</p><a class="button button--dark" href="https://www.youtube.com/@saveroomorg" target="_blank" rel="noreferrer">Meet us on YouTube ↗</a></div></div></section>
  <section class="principles section container"><div class="eyebrow">Core stats</div><div class="principle-grid"><div><span>01</span><h3>Classic first</h3><p>RPGs, strategy games, and old PC memories get the spotlight.</p></div><div><span>02</span><h3>Hardware matters</h3><p>The machines, shelves, and handhelds are part of the story.</p></div><div><span>03</span><h3>Useful tuning</h3><p>Workbench guides keep performance talk practical and grounded.</p></div></div></section>
  <SubscribeCta />
</BaseLayout>
<style>.about-hero{padding-top:100px;padding-bottom:110px}.about-hero h1{margin:24px 0}.about-hero h1 em{color:var(--terracotta);font-style:normal}.about-hero>p{max-width:48ch;font-size:1.2rem}.about-body{padding:90px 0;color:var(--cream);background:rgba(20,26,58,.7);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.about-grid{display:grid;grid-template-columns:180px 1fr;gap:40px}.big-number{font-family:var(--serif);font-size:6rem;color:var(--coral);line-height:.8}.about-body h2{margin:15px 0 22px}.about-body p{max-width:56ch;color:var(--muted);font-size:1.05rem}.principles>.eyebrow{margin-bottom:40px}.principle-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.principle-grid>div{padding:24px;background:rgba(20,26,58,.72);border:1px solid var(--line);border-radius:var(--radius-md)}.principle-grid span{color:var(--terracotta);font-size:.8rem;font-weight:800}.principle-grid h3{margin:15px 0 10px}.principle-grid p{font-size:.9rem}@media(max-width:680px){.about-hero{padding-top:70px;padding-bottom:80px}.about-grid{grid-template-columns:1fr;gap:35px}.big-number{font-size:4rem}.principle-grid{grid-template-columns:1fr}}
</style>
