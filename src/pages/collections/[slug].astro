---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoGrid from '../../components/VideoGrid.astro';
import { collections } from '../../data/collections';
import { videos, channelUrl } from '../../data/videos';
export function getStaticPaths() { return collections.map((collection) => ({ params: { slug: collection.slug }, props: { collection } })); }
const { collection } = Astro.props;
---
<BaseLayout title={collection.title} description={collection.description}>
  <section class={`collection-hero ${collection.accent}`}><div class="container"><a class="back-link" href="/collections">← All collections</a><div class="eyebrow">{collection.eyebrow}</div><h1>{collection.title}</h1><p>{collection.description}</p></div></section>
  <section class="section container"><div class="intro-row"><div><div class="eyebrow">Queued videos</div><h2>Load this<br /><em>playlist.</em></h2></div><p>Browse the Save Room videos that match this lane, then jump to YouTube for the full channel archive.</p></div><VideoGrid videos={videos.filter((video) => video.category === collection.title || (collection.slug === 'classic-rpgs' && video.category === 'Strategy Classics'))} /><div class="channel-callout"><span>More saves are waiting on YouTube.</span><a class="button button--dark" href={`${channelUrl}/videos`} target="_blank" rel="noreferrer">Explore Save Room ↗</a></div></section>
</BaseLayout>
<style>.collection-hero{padding:40px 0 90px;border-bottom:1px solid var(--line)}.collection-hero.magenta{background:linear-gradient(135deg,rgba(255,79,216,.28),rgba(20,26,58,.68))}.collection-hero.cyan{background:linear-gradient(135deg,rgba(39,245,255,.24),rgba(20,26,58,.68))}.collection-hero.yellow{background:linear-gradient(135deg,rgba(255,230,109,.23),rgba(20,26,58,.68))}.back-link{display:inline-block;margin-bottom:80px;color:var(--coral);font-size:.9rem;font-weight:800;text-decoration:none;text-transform:uppercase}.collection-hero h1{margin:20px 0 12px;font-size:clamp(3.5rem,10vw,8rem)}.collection-hero p{max-width:46ch;color:var(--muted);font-size:1.1rem}.intro-row{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:50px;margin-bottom:40px}.intro-row h2{margin:14px 0}.intro-row h2 em{color:var(--terracotta);font-style:normal}.intro-row>p{max-width:36ch}.channel-callout{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:26px;padding:24px 0;border-top:1px solid var(--line)}.channel-callout span{color:var(--muted)}@media(max-width:680px){.back-link{margin-bottom:50px}.intro-row{grid-template-columns:1fr;gap:10px}.channel-callout{align-items:flex-start;flex-direction:column}}
</style>
