---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { collections } from '../../data/collections';
---
<BaseLayout title="Collections" description="Explore Save Room collections covering classic RPGs, retro hardware, and practical PC workbench guides." breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Collections', path: '/collections' }]}>
  <section class="page-intro container"><div class="eyebrow">Save slots</div><h1>Pick your<br /><em>loadout.</em></h1><p>Start with classic worlds, the hardware shelf, or the PC tuning bench.</p></section>
  <section class="section section--tight container"><SectionHeading title="Choose your own adventure." description="Every lane points back to the same thing: games and machines worth remembering." /><div class="collection-list">{collections.map((collection) => <CollectionCard collection={collection} />)}</div></section>
</BaseLayout>
<style>.page-intro{padding-top:80px;padding-bottom:35px}.page-intro h1{margin:20px 0}.page-intro h1 em{color:var(--terracotta);font-style:normal}.page-intro p{font-size:1.1rem}.collection-list{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}@media(max-width:800px){.collection-list{grid-template-columns:1fr 1fr}}@media(max-width:520px){.collection-list{grid-template-columns:1fr}}</style>
